{
  "name": "wcag-audit-skill",
  "version": "0.1.0",
  "description": "Accessibility (WCAG 2.2) audit skill for AI coding agents, plus a CLI: static source scan, real-browser runtime scan (Playwright + axe-core), verified findings, JSON and SARIF output.",
  "type": "module",
  "bin": {
    "wcag-audit-skill": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "integrations",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "playwright",
    "sarif",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "ai-agent",
    "audit"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "axe-core": "^4.14.0",
    "playwright-core": "^1.65.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
